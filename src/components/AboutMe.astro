---
import InfiniteSlider from './InfiniteSlider.astro'
import { getLang } from '../i18n/ui'

const lang = getLang(Astro.currentLocale)
---

<article
	class="flex flex-col items-center justify-center gap-8 text-gray-700 dark:text-gray-300 md:flex-row"
>
	<div
		class="[&>p]:mb-4 [&>p>strong]:text-amber-800 dark:[&>p>strong]:text-yellow-100 [&>p>strong]:font-normal [&>p>strong]:font-mono text-pretty order-2 md:order-1"
	>
		{
			lang === 'es' ? (
				<>
					<p>
						Soy Sergio Huertas. Estudié <strong>Ingeniería Informática en la Universidad Rey Juan Carlos</strong> y me especialicé en el desarrollo frontend y móvil.
					</p>
					<p>
						Hasta la fecha he colaborado en <strong>más de 10 proyectos, la mayoría con equipos y clientes internacionales en entornos ágiles</strong>. Mi objetivo es crear interfaces claras y soluciones fiables, adaptadas a las necesidades de cada proyecto.
					</p>
					<p>
						Trabajo principalmente con <strong>React, React Native y TypeScript</strong>, además de integrar APIs y realizar pruebas de frontend. Estas son algunas de las tecnologías que utilizo:
					</p>
				</>
			) : (
				<>
					<p>
						I'm Sergio Huertas. I studied <strong>Computer Engineering at Universidad Rey Juan Carlos</strong> and specialized in frontend and mobile development.
					</p>
					<p>
						So far, I've contributed to <strong>more than 10 projects, mostly with international teams and clients in agile environments</strong>. My goal is to build clear interfaces and reliable solutions tailored to each project's needs.
					</p>
					<p>
						I work mainly with <strong>React, React Native and TypeScript</strong>, alongside API integration and frontend testing. Here are some of the technologies I use:
					</p>
				</>
			)
		}
	</div>

	<img
		width="200"
		height="200"
		src="/sergio-logo.webp"
		alt="Sergio Huertas"
		class="order-1 object-cover w-64 h-full p-1 md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl bg-black/20 dark:bg-yellow-500/5 ring-1 ring-black/70 dark:ring-white/20"
		style="object-position: 50% 50%"
	/>
</article>
<section class="flex flex-col items-center mt-2 text-gray-700 dark:text-gray-400">
	<InfiniteSlider />
</section>
