---
import React from './icons/React.astro'
import Apple from './icons/Apple.astro'
import Android from './icons/Android.astro'
import Redux from './icons/Redux.astro'
import Jest from './icons/Jest.astro'
import Docker from './icons/Docker.astro'
import Cypress from './icons/Cypress.astro'
import Link from './icons/Link.astro'
import LinkButton from './LinkButton.astro'
import { getLang, useTranslations } from '../i18n/ui'

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)

const TAGS = {
	REACT: {
		name: 'React',
		class: 'bg-[#61DAFB] text-white',
		icon: React,
	},
	REACT_NATIVE: {
		name: 'React Native',
		class: 'bg-[#61DAFB] text-white',
		icon: React,
	},
	REDUX: {
		name: 'Redux',
		class: 'bg-[#764ABC] text-white',
		icon: Redux,
	},
	JEST: {
		name: 'Jest',
		class: 'bg-[#99425B] text-white',
		icon: Jest,
	},
	IOS: {
		name: 'iOS',
		class: 'bg-[#303030] text-white',
		icon: Apple,
	},
	ANDROID: {
		name: 'Android',
		class: 'bg-[#3DDC84] text-white',
		icon: Android,
	},
	DOCKER: {
		name: 'Docker',
		class: 'bg-[#2496ED] text-white',
		icon: Docker,
	},
	CYPRESS: {
		name: 'Cypress',
		class: 'bg-emerald-200 text-teal-600',
		icon: Cypress,
	},
}

const PROJECTS = [
	{
		title: { en: 'Sports betting', es: 'Apuestas deportivas' },
		description: {
			en: 'At FDJ / Sporting Solutions, I developed and maintained React web widgets and a sports betting platform for international clients. This included market displays, betslips, competitions and retail interfaces. I also contributed to frontend testing with Cypress in a distributed agile team.',
			es: 'En FDJ / Sporting Solutions desarrollé y mantuve widgets web con React y una plataforma de apuestas deportivas para clientes internacionales. Trabajé en mercados, boletos de apuestas, competiciones e interfaces retail, además de colaborar en pruebas de frontend con Cypress dentro de un equipo ágil distribuido.',
		},
		link: 'https://prolineplus.olg.ca/en-ca',
		image: '/projects/proline-mockup.webp',
		tags: [TAGS.REACT, TAGS.CYPRESS, TAGS.JEST, TAGS.DOCKER],
	},
	{
		title: { en: 'Retro Football Management', es: 'Retro Football Management' },
		description: {
			en: 'While at Yapiko, I developed this football management game for Coast Gaming on iOS and Android with React Native, Redux and Realm. The app has passed 700,000 downloads.',
			es: 'Durante mi etapa en Yapiko desarrollé este juego de gestión de fútbol para Coast Gaming en iOS y Android con React Native, Redux y Realm. La app ha superado las 700.000 descargas.',
		},
		link: 'https://play.google.com/store/apps/details?id=com.rfm&hl=en_GB',
		link2:
			'https://apps.apple.com/gb/app/retro-football-management/id1383661436',
		image: '/projects/cropped-RFM.webp',
		tags: [TAGS.REACT_NATIVE, TAGS.REDUX, TAGS.JEST, TAGS.IOS, TAGS.ANDROID],
		customImgClass: 'py-8',
	},
	{
		title: { en: 'ROBOTIX Link C360', es: 'ROBOTIX Link C360' },
		description: {
			en: 'At Yapiko, I worked on this robotics education platform for ROBOTIX. I developed a block programming editor with Blockly and Monaco and an iPad app that connects to robots via Bluetooth, with voice and vision features.',
			es: 'En Yapiko trabajé en esta plataforma de educación robótica para ROBOTIX. Desarrollé un editor de programación por bloques con Blockly y Monaco y una app para iPad que se conecta a robots mediante Bluetooth, con funciones de voz y visión.',
		},
		link: 'https://apps.apple.com/es/app/robotix-link-c360/id1575399336',
		image: '/projects/robotix-ipad-mockup.webp',
		tags: [TAGS.REACT, TAGS.IOS],
		appStoreOnly: true,
	},
]
---

<div class="flex flex-col gap-y-16">
	{
		PROJECTS.map(
			({ image, title, description, tags, link, link2, customImgClass, appStoreOnly }) => (
				<article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
					<div class="w-full md:w-1/2">
						<div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
							<img
								alt={`${t('projects.screenshot')} ${title[lang]}`}
								class={`object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105 ${customImgClass}`}
								loading="lazy"
								src={image}
							/>
						</div>
					</div>

					<div class="w-full md:w-1/2 md:max-w-lg">
						<h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
							{title[lang]}
						</h3>
						<div class="flex flex-wrap mt-2">
							<ul class="flex flex-row mb-2 gap-x-2">
								{tags.map((tag) => (
									<li>
										<span
											class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 items-center text-nowrap`}
										>
											<tag.icon class="size-4" />
											{tag.name}
										</span>
									</li>
								))}
							</ul>

							<div class="mt-2 text-gray-700 dark:text-gray-400 text-pretty">
								{description[lang]}
							</div>
							<footer class="flex items-end justify-start mt-4 gap-x-4">
								{link && (
									<LinkButton href={link}>
										{link2 ? (
											<Android class="size-4" />
										) : appStoreOnly ? (
											<Apple class="size-4" />
										) : (
											<Link class="size-4" />
										)}
										{link2 ? 'Android' : appStoreOnly ? 'App Store' : t('projects.preview')}
									</LinkButton>
								)}
								{link2 && (
									<LinkButton href={link2}>
										<Apple class="size-4" />
										IOS
									</LinkButton>
								)}
							</footer>
						</div>
					</div>
				</article>
			)
		)
	}
</div>
