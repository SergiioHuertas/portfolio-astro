---
import ExperienceItem from './ExperienceItem.astro'
import { getLang } from '../i18n/ui'

const lang = getLang(Astro.currentLocale)

const EXPERIENCE = [
	{
		company: 'YAPIKO SOFTWARE HOUSE S.L.',
		link: 'https://yapiko.com/',
		en: {
			title: 'Frontend / Mobile Developer',
			date: 'May 2018 – November 2026',
			description: `Developed <span class="highligh-desc">React</span> web applications and <span class="highligh-desc">React Native</span> mobile apps for international clients. For FDJ / Sporting Solutions, built and maintained sports betting platforms and widgets within a distributed agile team.<br/><br/>For Coast Gaming, developed <span class="highligh-desc">Retro Football Management</span> for iOS and Android with React Native, Redux and Realm; the game passed 700,000 downloads. On <span class="highligh-desc">ROBOTIX</span>, built a Blockly and Monaco programming editor and an iOS app, connecting to robots via Web Bluetooth / BLE and adding voice and vision features with the Web Speech API and MediaPipe.<br/><br/>Also developed a React and AWS Cognito application for Naturgy, Google Maps and REST / SOAP integrations for Restaurantes.com, and internal web and mobile projects.`,
		},
		es: {
			title: 'Desarrollador Frontend / Mobile',
			date: 'Mayo de 2018 – noviembre de 2026',
			description: `Desarrollé aplicaciones web con <span class="highligh-desc">React</span> y aplicaciones móviles con <span class="highligh-desc">React Native</span> para clientes internacionales. Para FDJ / Sporting Solutions, desarrollé y mantuve plataformas y widgets de apuestas deportivas en un equipo ágil distribuido.<br/><br/>Para Coast Gaming, desarrollé <span class="highligh-desc">Retro Football Management</span> para iOS y Android con React Native, Redux y Realm; el juego superó las 700.000 descargas. En <span class="highligh-desc">ROBOTIX</span>, desarrollé un editor de programación con Blockly y Monaco y una app iOS, con conexión a robots mediante Web Bluetooth / BLE y funciones de voz y visión con Web Speech API y MediaPipe.<br/><br/>También desarrollé una aplicación con React y AWS Cognito para Naturgy, integraciones con Google Maps y APIs REST / SOAP para Restaurantes.com, y proyectos internos web y móviles.`,
		},
	},
	{
		company: 'INDRA SISTEMAS S.A.',
		link: 'https://www.indracompany.com/',
		en: {
			title: 'Junior Developer Intern',
			date: 'January – August 2017',
			description: `Developed an <span class="highligh-desc">air control and surveillance application</span> in Java with Maven and Eclipse on Ubuntu; worked with SVN and SQL databases.`,
		},
		es: {
			title: 'Desarrollador junior en prácticas',
			date: 'Enero – agosto de 2017',
			description: `Desarrollé una <span class="highligh-desc">aplicación de control y vigilancia aérea</span> en Java con Maven y Eclipse sobre Ubuntu; trabajé con SVN y bases de datos SQL.`,
		},
	},
	{
		company: 'SPIKA TECH S.L.',
		link: 'https://www.spikatech.com/',
		en: {
			title: 'Junior Developer Intern',
			date: 'March – June 2016',
			description: `Developed a <span class="highligh-desc">travel and transport website</span> on Joomla with PHP 5, Bootstrap, jQuery and SQL.`,
		},
		es: {
			title: 'Desarrollador junior en prácticas',
			date: 'Marzo – junio de 2016',
			description: `Desarrollé una <span class="highligh-desc">web de viajes y transporte</span> sobre Joomla con PHP 5, Bootstrap, jQuery y SQL.`,
		},
	},
]
---

<ol class="relative mt-16">
	{
		EXPERIENCE.map((experience) => (
			<li>
				<ExperienceItem
					company={experience.company}
					link={experience.link}
					{...experience[lang]}
				/>
			</li>
		))
	}
</ol>
